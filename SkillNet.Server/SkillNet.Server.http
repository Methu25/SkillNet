@SkillNet.Server_HostAddress = http://localhost:5090
@token = YOUR_JWT_TOKEN_HERE

### ----------------------------------------------------
### 1. Auth 
### ----------------------------------------------------

### Register
POST {{SkillNet.Server_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "MySecretPassword123",
  "roleName": "Admin" 
}

### Login
POST {{SkillNet.Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "MySecretPassword123"
}

### ----------------------------------------------------
### 2. User 
### ----------------------------------------------------

### Get All Users
GET {{SkillNet.Server_HostAddress}}/api/user
Authorization: Bearer {{token}}

### Create User
POST {{SkillNet.Server_HostAddress}}/api/user
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "newuser@test.com",
  "password": "Password123!",
  "roleName": "Candidate"
}

### Update User
PUT {{SkillNet.Server_HostAddress}}/api/user/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "updated@test.com"
}

### Delete User
DELETE {{SkillNet.Server_HostAddress}}/api/user/1
Authorization: Bearer {{token}}

### Toggle User Status
PUT {{SkillNet.Server_HostAddress}}/api/user/1/toggle-status
Authorization: Bearer {{token}}

### Reset User Password
POST {{SkillNet.Server_HostAddress}}/api/user/1/reset-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "newPassword": "NewPassword123!"
}

### ----------------------------------------------------
### 3. Organization 
### ----------------------------------------------------

### Get All Organizations
GET {{SkillNet.Server_HostAddress}}/api/organization
Authorization: Bearer {{token}}

### Create Organization
POST {{SkillNet.Server_HostAddress}}/api/organization
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Acme Corp",
  "description": "Tech Company"
}

### Update Organization
PUT {{SkillNet.Server_HostAddress}}/api/organization/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Acme Corp Updated",
  "description": "Tech Company Updated"
}

### Delete Organization
DELETE {{SkillNet.Server_HostAddress}}/api/organization/1
Authorization: Bearer {{token}}

### ----------------------------------------------------
### 4. Department 
### ----------------------------------------------------

### Get All Departments
GET {{SkillNet.Server_HostAddress}}/api/department
Authorization: Bearer {{token}}

### Create Department
POST {{SkillNet.Server_HostAddress}}/api/department
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Engineering",
  "organizationId": 1
}

### Update Department
PUT {{SkillNet.Server_HostAddress}}/api/department/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Engineering Updated",
  "organizationId": 1
}

### Delete Department
DELETE {{SkillNet.Server_HostAddress}}/api/department/1
Authorization: Bearer {{token}}

### ----------------------------------------------------
### 5. System Configuration 
### ----------------------------------------------------

### Get System Configuration
GET {{SkillNet.Server_HostAddress}}/api/systemconfiguration
Authorization: Bearer {{token}}

### Update System Configuration
PUT {{SkillNet.Server_HostAddress}}/api/systemconfiguration
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "settingKey": "Theme",
  "settingValue": "Dark"
}

### ----------------------------------------------------
### 6. Dashboard 
### ----------------------------------------------------

### Get Dashboard Statistics
GET {{SkillNet.Server_HostAddress}}/api/dashboard/statistics
Authorization: Bearer {{token}}

### ----------------------------------------------------
### 7. User Role 
### ----------------------------------------------------

### Get All User Roles
GET {{SkillNet.Server_HostAddress}}/api/userrole
Authorization: Bearer {{token}}

### Create User Role
POST {{SkillNet.Server_HostAddress}}/api/userrole
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Manager",
  "description": "Department Manager"
}

### ----------------------------------------------------
### 8. Audit Log 
### ----------------------------------------------------

### Get Audit Logs
GET {{SkillNet.Server_HostAddress}}/api/auditlog
Authorization: Bearer {{token}}

### ----------------------------------------------------
### 9. Test Secure (Role Testing)
### ----------------------------------------------------

### Test All Users
GET {{SkillNet.Server_HostAddress}}/api/testsecure/all-users
Authorization: Bearer {{token}}

### Test Admin Only
GET {{SkillNet.Server_HostAddress}}/api/testsecure/admin-only
Authorization: Bearer {{token}}

### Test Candidate Only
GET {{SkillNet.Server_HostAddress}}/api/testsecure/candidate-only
Authorization: Bearer {{token}}